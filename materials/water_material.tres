[gd_resource type="Shader" format=3 uid="uid://dx658hm0xqn8q"]

[resource]
code = "shader_type canvas_item;

uniform float wave_speed : hint_range(0.0, 5.0) = 1.2;
uniform float wave_strength : hint_range(0.0, 0.1) = 0.03;
uniform float wave_scale : hint_range(1.0, 50.0) = 20.0;
uniform vec4 tint_color : source_color = vec4(0.2, 0.6, 1.0, 0.2);
uniform float shimmer_speed : hint_range(0.0, 5.0) = 1.0;
uniform vec2 scroll_speed = vec2(0.02, 0.015);

void fragment() {
	vec2 uv = UV;

	
	vec2 wave1 = vec2(
		sin(uv.y * wave_scale + TIME * wave_speed) * wave_strength,
		cos(uv.x * wave_scale + TIME * wave_speed) * wave_strength
	);

	
	vec2 wave2 = vec2(
		sin(uv.y * wave_scale * 2.3 - TIME * wave_speed * 1.7) * wave_strength * 0.5,
		cos(uv.x * wave_scale * 2.3 - TIME * wave_speed * 1.7) * wave_strength * 0.5
	);

	// Layer 3: panning/scrolling motion para may \"flow\" yung tubig
	vec2 scroll = TIME * scroll_speed;

	vec2 final_uv = uv + wave1 + wave2 + scroll * 0.0; // scroll dinagdag sa sampling, hindi sa uv mismo
	vec4 base_color = texture(TEXTURE, fract(final_uv));

	// Ilaw / caustics-like shimmer, multiple layers para mas \"buhay\"
	float shimmer1 = sin((uv.x * 30.0 + uv.y * 20.0) + TIME * shimmer_speed);
	float shimmer2 = sin((uv.x * 15.0 - uv.y * 35.0) - TIME * shimmer_speed * 1.3);
	float shimmer = smoothstep(0.9, 1.0, shimmer1) * 0.4 + smoothstep(0.92, 1.0, shimmer2) * 0.3;

	// Brightness pulse para may \"depth\" feel
	float pulse = sin(TIME * 0.5 + uv.x * 5.0) * 0.05;

	vec4 final_color = base_color + vec4(shimmer + pulse);
	final_color.rgb = mix(final_color.rgb, tint_color.rgb, tint_color.a);

	COLOR = final_color;
	COLOR.a = base_color.a;
}"
